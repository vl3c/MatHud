{
  "schema": 1,
  "area": "CV",
  "title": "Canvas operations: view, coordinate systems, undo and redo",
  "scenarios": [
    {
      "id": "CV-01",
      "title": "Undo a zoom",
      "tags": ["view", "undo"],
      "smoke": false,
      "targets": "view state outside the undo snapshot",
      "steps": [
        {
          "user": "Zoom to x between -2 and 2 around the origin.",
          "reference": [{"tool": "zoom", "args": {"center_x": 0, "center_y": 0, "range_val": 2, "range_axis": "x"}}],
          "checks": [
            {"check": "attribute", "path": "left_bound", "target": "view", "eq": -2},
            {"check": "attribute", "path": "right_bound", "target": "view", "eq": 2}
          ]
        },
        {
          "user": "Undo that.",
          "reference": [{"tool": "undo", "args": {}}],
          "checks": [{"check": "state_equals", "snapshot": "start", "view": true}]
        }
      ]
    },
    {
      "id": "CV-02",
      "title": "Undo a multi-object construction in one step",
      "tags": ["undo", "redo", "constructions"],
      "smoke": true,
      "targets": "undo stack out of sync with tool batches; one undo step per reply, over all its batches",
      "steps": [
        {
          "user": "Draw triangle ABC with vertices (0,0), (6,0), (2,4) and its circumcircle.",
          "note": "The reference is a reply of two batches; the first live run took three, and 'Undo that' then removed only the circle.",
          "reference": [
            [
              {
                "tool": "create_polygon",
                "args": {
                  "vertices": [{"x": 0, "y": 0}, {"x": 6, "y": 0}, {"x": 2, "y": 4}],
                  "polygon_type": "triangle",
                  "name": "ABC"
                }
              }
            ],
            [{"tool": "construct_circumcircle", "args": {"triangle_name": "ABC"}}]
          ],
          "checks": [
            {"check": "exists", "select": {"type": "Circle", "center": [3, 1], "radius": 3.1622776601683795}}
          ]
        },
        {"snapshot": "after_t1"},
        {
          "user": "Undo that.",
          "reference": [{"tool": "undo", "args": {}}],
          "checks": [{"check": "state_equals", "snapshot": "start"}]
        },
        {"do": [{"tool": "redo", "args": {}}], "checks": [{"check": "state_equals", "snapshot": "after_t1"}]}
      ]
    },
    {
      "id": "CV-03",
      "title": "Clear, then undo",
      "tags": ["view", "undo", "clear"],
      "smoke": false,
      "targets": "clear resets the view outside undo",
      "setup": {
        "calls": [
          {
            "tool": "create_polygon",
            "args": {
              "vertices": [{"x": 0, "y": 0}, {"x": 4, "y": 0}, {"x": 0, "y": 3}],
              "polygon_type": "triangle",
              "name": "ABC"
            }
          },
          {"tool": "create_circle", "args": {"center_x": 10, "center_y": 10, "radius": 2}},
          {"tool": "zoom", "args": {"center_x": 0, "center_y": 0, "range_val": 10, "range_axis": "x"}}
        ]
      },
      "steps": [
        {
          "user": "Clear the canvas.",
          "reference": [{"tool": "clear_canvas", "args": {}}],
          "checks": [
            {"check": "count", "select": {"type": "Point"}, "eq": 0},
            {"check": "count", "select": {"type": "Polygon"}, "eq": 0},
            {"check": "count", "select": {"type": "Circle"}, "eq": 0}
          ]
        },
        {
          "user": "Oops, bring it all back.",
          "reference": [{"tool": "undo", "args": {}}],
          "checks": [
            {"check": "state_equals", "snapshot": "setup"},
            {"check": "attribute", "path": "left_bound", "target": "view", "eq": -10},
            {"check": "attribute", "path": "right_bound", "target": "view", "eq": 10}
          ]
        }
      ]
    },
    {
      "id": "CV-04",
      "title": "Undo when there is nothing to undo",
      "tags": ["undo", "results"],
      "smoke": false,
      "targets": "untruthful tool results",
      "steps": [
        {
          "user": "Undo.",
          "reference": [{"tool": "undo", "args": {}}],
          "checks": [{"check": "tool_result", "tool": "undo", "ne": "Call successful!"}]
        }
      ]
    },
    {
      "id": "CV-05",
      "title": "Clearing after a zoom resets the polar grid too",
      "tags": ["view", "coordinate-systems", "clear"],
      "smoke": false,
      "targets": "Canvas.reset resets the Cartesian grid but not the polar grid's zoom-adapted ring spacing, so polar mode after a clear draws thousands of rings (found by the replay suite: WS-01's load took 30 to 57 s after CV-01)",
      "steps": [
        {
          "user": "Zoom to x between -2 and 2 around the origin.",
          "reference": [{"tool": "zoom", "args": {"center_x": 0, "center_y": 0, "range_val": 2, "range_axis": "x"}}]
        },
        {
          "user": "Clear the canvas and switch to the polar grid.",
          "reference": [
            {"tool": "clear_canvas", "args": {}},
            {"tool": "set_coordinate_system", "args": {"mode": "polar"}}
          ],
          "checks": [
            {"check": "attribute", "path": "left_bound", "target": "view", "same_as": "start"},
            {"check": "attribute", "path": "mode", "target": "view", "eq": "polar"},
            {"check": "attribute", "path": "polar_radial_spacing", "target": "inspection", "same_as": "start"}
          ]
        }
      ]
    },
    {
      "id": "CV-06",
      "title": "Repeating a change that is already in effect is a no-op",
      "tags": ["view", "circles", "update", "undo", "results"],
      "smoke": false,
      "targets": "tools that succeed without changing anything must say so and must not add an undo entry",
      "setup": {
        "calls": [
          {"tool": "create_circle", "args": {"center_x": 0, "center_y": 0, "radius": 2, "color": "red"}},
          {"tool": "zoom", "args": {"center_x": 0, "center_y": 0, "range_val": 2, "range_axis": "x"}}
        ]
      },
      "steps": [
        {
          "user": "Make the circle red.",
          "reference": [{"tool": "update_circle", "args": {"name": "A(2)", "new_color": "red"}}],
          "checks": [
            {"check": "state_equals", "snapshot": "setup", "inspect": true, "view": true},
            {"check": "attribute", "target": "inspection", "path": "undo_depth", "same_as": "setup"},
            {"check": "tool_result", "tool": "update_circle", "ne": "Call successful!"}
          ]
        },
        {"snapshot": "after_colour"},
        {
          "user": "Zoom to x between -2 and 2 around the origin.",
          "reference": [{"tool": "zoom", "args": {"center_x": 0, "center_y": 0, "range_val": 2, "range_axis": "x"}}],
          "checks": [
            {"check": "state_equals", "snapshot": "setup", "inspect": true, "view": true},
            {"check": "attribute", "target": "inspection", "path": "undo_depth", "same_as": "after_colour"},
            {"check": "tool_result", "tool": "zoom", "ne": "Call successful!"}
          ]
        }
      ]
    },
    {
      "id": "CV-07",
      "title": "An undo inside a reply reverts that reply's changes",
      "tags": ["undo", "multi-batch"],
      "smoke": false,
      "targets": "undo and redo calls inside a turn close the turn's undo group first; later changes form one new step",
      "setup": {"calls": [{"tool": "create_point", "args": {"x": 0, "y": 0, "name": "A"}}]},
      "steps": [
        {
          "user": "Put a point P at (5, 5). Actually, undo that and put P at (5, 6) instead.",
          "reference": [
            [{"tool": "create_point", "args": {"x": 5, "y": 5, "name": "P"}}],
            [{"tool": "undo", "args": {}}],
            [{"tool": "create_point", "args": {"x": 5, "y": 6, "name": "P"}}]
          ],
          "checks": [
            {"check": "point_at", "select": {"type": "Point", "name": "P"}, "at": [5, 6]},
            {"check": "absent", "select": {"type": "Point", "at": [5, 5]}},
            {"check": "point_at", "select": {"type": "Point", "name": "A"}, "at": [0, 0]},
            {"check": "attribute", "target": "inspection", "path": "redo_depth", "eq": 0}
          ]
        },
        {
          "do": [{"tool": "undo", "args": {}}],
          "checks": [{"check": "state_equals", "snapshot": "setup"}]
        },
        {
          "do": [{"tool": "redo", "args": {}}],
          "checks": [{"check": "point_at", "select": {"type": "Point", "name": "P"}, "at": [5, 6]}]
        }
      ]
    }
  ]
}
