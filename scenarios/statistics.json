    {
      "id": "ST-12",
      "title": "Scatter plot then a trend line",
      "tags": ["statistics", "plots", "regression"],
      "smoke": false,
      "targets": "plot_scatter draws one plot (no points) and reports r; fit_regression with show_points false adds only the line",
      "steps": [
        {
          "user": "Make a scatter plot of hours studied 1, 2, 3, 4, 5 against scores 52, 60, 71, 80, 86, then add a linear trend line without extra points.",
          "reference": [
            {
              "tool": "plot_scatter",
              "args": {"name": null, "x_data": [1, 2, 3, 4, 5], "y_data": [52, 60, 71, 80, 86], "color": null}
            },
            {
              "tool": "fit_regression",
              "args": {
                "name": null,
                "x_data": [1, 2, 3, 4, 5],
                "y_data": [52, 60, 71, 80, 86],
                "model_type": "linear",
                "degree": null,
                "plot_bounds": null,
                "curve_color": null,
                "show_points": false,
                "point_color": null
              }
            }
          ],
          "checks": [
            {"check": "no_tool_errors"},
            {"check": "count", "select": {"type": "ScatterPlot"}, "eq": 1},
            {"check": "count", "select": {"type": "Function"}, "eq": 1},
            {"check": "absent", "select": {"type": "Point"}},
            {"check": "tool_result", "tool": "plot_scatter", "path": "n", "eq": 5}
          ]
        }
      ]
    },
    {
      "id": "ST-13",
      "title": "Two-sample t test and confidence interval from data",
      "tags": ["statistics", "read-only"],
      "smoke": false,
      "targets": "non-canvas inference tools; Welch df, p-value and interval",
      "steps": [
        {
          "user": "Drug A: 0.7, -1.6, -0.2, -1.2, -0.1, 3.4, 3.7, 0.8, 0.0, 2.0. Drug B: 1.9, 0.8, 1.1, 0.1, -0.1, 4.4, 5.5, 1.6, 4.6, 3.4. Is there a significant difference in the means at the 5% level (Welch t test), and what is the 95% confidence interval for the difference?",
          "reference": [
            {
              "tool": "hypothesis_test",
              "args": {
                "test_type": "two_sample_t",
                "sample1": {"data": [0.7, -1.6, -0.2, -1.2, -0.1, 3.4, 3.7, 0.8, 0.0, 2.0]},
                "sample2": {"data": [1.9, 0.8, 1.1, 0.1, -0.1, 4.4, 5.5, 1.6, 4.6, 3.4]},
                "alternative": "two_sided",
                "alpha": 0.05
              }
            },
            {
              "tool": "confidence_interval",
              "args": {
                "interval_type": "two_sample_t",
                "sample1": {"data": [0.7, -1.6, -0.2, -1.2, -0.1, 3.4, 3.7, 0.8, 0.0, 2.0]},
                "sample2": {"data": [1.9, 0.8, 1.1, 0.1, -0.1, 4.4, 5.5, 1.6, 4.6, 3.4]},
                "confidence_level": 0.95
              }
            }
          ],
          "checks": [
            {"check": "tool_result", "tool": "hypothesis_test", "path": "p_value", "eq": 0.0793941401874, "tol": 1e-09},
            {"check": "tool_result", "tool": "hypothesis_test", "path": "reject_null", "eq": false},
            {"check": "tool_result", "tool": "confidence_interval", "path": "lower", "eq": -3.36548323, "tol": 1e-06},
            {"check": "tool_result", "tool": "confidence_interval", "path": "upper", "eq": 0.20548323, "tol": 1e-06},
            {"check": "state_equals", "snapshot": "start"},
            {"check": "answer_mentions", "matches": "0\\.079|fail to reject|not significant"}
          ]
        }
      ]
    },
    {
      "id": "ST-14",
      "title": "Chi-squared test of independence",
      "tags": ["statistics", "read-only"],
      "smoke": false,
      "targets": "non-canvas chi_squared_test; statistic, df and p-value",
      "steps": [
        {
          "user": "Party by gender: women 762 Democrat, 327 Independent, 468 Republican; men 484, 239, 477. Run a chi-square test of independence.",
          "reference": [
            {
              "tool": "chi_squared_test",
              "args": {"test_type": "independence", "table": [[762, 327, 468], [484, 239, 477]]}
            }
          ],
          "checks": [
            {"check": "tool_result", "tool": "chi_squared_test", "path": "df", "eq": 2},
            {"check": "tool_result", "tool": "chi_squared_test", "path": "p_value", "eq": 2.95358918321e-07, "tol": 1e-12},
            {"check": "state_equals", "snapshot": "start"},
            {"check": "answer_mentions", "matches": "30\\.07|2\\.95|reject"}
          ]
        }
      ]
    }
  ]
}
