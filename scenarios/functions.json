{
  "schema": 1,
  "area": "FN",
  "title": "Functions, piecewise and parametric curves, tangents and normals",
  "scenarios": [
    {
      "id": "FN-01",
      "title": "Function with an asymptote and a shaded area",
      "tags": ["functions", "areas", "asymptotes", "null-arguments"],
      "smoke": true,
      "targets": "schema says color is optional but null is rejected",
      "steps": [
        {
          "user": "Plot f(x) = 1/(x-1) from -5 to 5 and shade the area between f and the x-axis from x=2 to x=4.",
          "reference": [
            {
              "tool": "draw_function",
              "args": {"function_string": "1/(x-1)", "name": "f", "left_bound": -5, "right_bound": 5}
            },
            {"tool": "create_colored_area", "args": {"drawable1_name": "f", "left_bound": 2, "right_bound": 4}}
          ],
          "checks": [
            {
              "check": "attribute",
              "path": "args.vertical_asymptotes",
              "select": {"type": "Function", "name": "f"},
              "eq": [1]
            },
            {
              "check": "relation",
              "relation": "function_value",
              "select": [{"type": "Function", "name": "f"}],
              "x": 3,
              "y": 0.5
            },
            {
              "check": "exists",
              "select": {
                "type": "FunctionsBoundedColoredArea",
                "where": {"args.func1": "f", "args.func2": "x_axis", "args.left_bound": 2, "args.right_bound": 4}
              }
            },
            {"check": "no_tool_errors"}
          ]
        }
      ]
    },
    {
      "id": "FN-02",
      "title": "Shifting a function moves its asymptotes",
      "tags": ["functions", "transforms", "asymptotes", "derived"],
      "smoke": false,
      "targets": "cached analysis not updated by transforms",
      "setup": {
        "calls": [
          {
            "tool": "draw_function",
            "args": {"function_string": "1/x", "name": "f", "left_bound": -10, "right_bound": 10}
          }
        ]
      },
      "steps": [
        {
          "user": "Shift f two units right and three up.",
          "reference": [{"tool": "translate_object", "args": {"name": "f", "x_offset": 2, "y_offset": 3}}],
          "checks": [
            {
              "check": "relation",
              "relation": "function_value",
              "select": [{"type": "Function", "name": "f"}],
              "values": [[3, 4], [4, 3.5]]
            },
            {
              "check": "attribute",
              "path": "args.vertical_asymptotes",
              "select": {"type": "Function", "name": "f"},
              "eq": [2]
            },
            {
              "check": "attribute",
              "path": "args.horizontal_asymptotes",
              "select": {"type": "Function", "name": "f"},
              "contains": 3
            },
            {"check": "attribute", "path": "args.left_bound", "select": {"type": "Function", "name": "f"}, "eq": -8},
            {"check": "attribute", "path": "args.right_bound", "select": {"type": "Function", "name": "f"}, "eq": 12}
          ]
        }
      ]
    },
    {
      "id": "FN-03",
      "title": "Redefining an existing function name",
      "tags": ["functions", "update", "asymptotes"],
      "smoke": false,
      "targets": "update-in-place path skipping re-analysis",
      "setup": {
        "calls": [
          {
            "tool": "draw_function",
            "args": {"function_string": "1/x", "name": "f", "left_bound": -10, "right_bound": 10}
          }
        ]
      },
      "steps": [
        {
          "user": "Actually, make f(x) = x^2 instead.",
          "reference": [
            {
              "tool": "draw_function",
              "args": {"function_string": "x^2", "name": "f", "left_bound": -10, "right_bound": 10}
            }
          ],
          "checks": [
            {"check": "count", "select": {"type": "Function", "name": "f"}, "eq": 1},
            {
              "check": "relation",
              "relation": "function_value",
              "select": [{"type": "Function", "name": "f"}],
              "x": 2,
              "y": 4
            },
            {
              "check": "attribute",
              "path": "args.vertical_asymptotes",
              "select": {"type": "Function", "name": "f"},
              "is_null": true
            }
          ]
        }
      ]
    },
    {
      "id": "FN-04",
      "title": "Piecewise function",
      "tags": ["functions", "piecewise"],
      "smoke": false,
      "targets": "piecewise parsing and interval semantics",
      "steps": [
        {
          "user": "Define g(x) = x^2 for x < 0 and g(x) = x for x >= 0.",
          "reference": [
            {
              "tool": "draw_piecewise_function",
              "args": {
                "name": "g",
                "pieces": [
                  {
                    "expression": "x^2",
                    "left": null,
                    "right": 0,
                    "left_inclusive": false,
                    "right_inclusive": false,
                    "undefined_at": null
                  },
                  {
                    "expression": "x",
                    "left": 0,
                    "right": null,
                    "left_inclusive": true,
                    "right_inclusive": false,
                    "undefined_at": null
                  }
                ]
              }
            }
          ],
          "checks": [
            {"check": "count", "select": {"type": "PiecewiseFunction"}, "eq": 1},
            {
              "check": "relation",
              "relation": "function_value",
              "select": [{"type": "PiecewiseFunction", "name": "g"}],
              "values": [[-2, 4], [3, 3], [0, 0]]
            }
          ]
        }
      ]
    },
    {
      "id": "FN-05",
      "title": "Tangent to a parametric circle",
      "tags": ["functions", "parametric", "tangents"],
      "smoke": false,
      "targets": "tangent math on parametric curves",
      "steps": [
        {
          "user": "Draw the unit circle as a parametric curve x=cos(t), y=sin(t) for t from 0 to 2*pi, then the tangent at t = pi/4.",
          "reference": [
            {
              "tool": "draw_parametric_function",
              "args": {
                "x_expression": "cos(t)",
                "y_expression": "sin(t)",
                "name": "p",
                "t_min": 0,
                "t_max": 6.283185307179586
              }
            },
            {"tool": "draw_tangent_line", "args": {"curve_name": "p", "parameter": 0.7853981633974483}}
          ],
          "checks": [
            {"bind": "T", "select": {"type": "Segment", "only": true}},
            {
              "check": "relation",
              "relation": "midpoint_of",
              "select": [{"coords": [0.7071067811865476, 0.7071067811865476]}, "$T"],
              "tol": 1e-06
            },
            {"check": "relation", "relation": "direction", "select": ["$T"], "perpendicular_to": [1, 1], "tol": 1e-06}
          ]
        }
      ]
    },
    {
      "id": "FN-06",
      "title": "Tangent at a vertical asymptote is refused",
      "tags": ["functions", "tangents", "asymptotes", "precision"],
      "smoke": false,
      "targets": "missing asymptote guard in tangent computation",
      "setup": {
        "calls": [
          {
            "tool": "draw_function",
            "args": {"function_string": "tan(x)", "name": "t", "left_bound": -4, "right_bound": 4}
          }
        ]
      },
      "steps": [
        {
          "user": "Draw the tangent to t at x = pi/2.",
          "reference": [{"tool": "draw_tangent_line", "args": {"curve_name": "t", "parameter": 1.5707963267948966}}],
          "checks": [{"check": "count", "select": {"type": "Segment"}, "eq": 0}]
        }
      ]
    },
    {
      "id": "FN-07",
      "title": "Tangent and normal to a parabola, then move the parabola",
      "tags": ["functions", "tangents", "transforms"],
      "smoke": false,
      "targets": "tangent math; static-construction semantics",
      "steps": [
        {
          "user": "Plot y = x^2, then draw its tangent and normal lines at x = 1.",
          "reference": [
            {"tool": "draw_function", "args": {"function_string": "x^2", "name": "sq"}},
            {"tool": "draw_tangent_line", "args": {"curve_name": "sq", "parameter": 1}},
            {"tool": "draw_normal_line", "args": {"curve_name": "sq", "parameter": 1}}
          ],
          "checks": [
            {"bind": "Sq", "select": {"type": "Function", "only": true}},
            {"bind": "Tan", "select": {"type": "Segment", "through": [1, 1], "slope": 2, "tol": 1e-06}},
            {"bind": "Nor", "select": {"type": "Segment", "through": [1, 1], "slope": -0.5, "tol": 1e-06}},
            {
              "check": "relation",
              "relation": "tangent_to",
              "select": ["$Tan", "$Sq"],
              "x": 1,
              "tol": 1e-06
            }
          ]
        },
        {"snapshot": "after_t1"},
        {
          "user": "Shift the parabola 2 units to the right.",
          "reference": [{"tool": "translate_object", "args": {"name": "sq", "x_offset": 2, "y_offset": 0}}],
          "checks": [
            {
              "check": "relation",
              "relation": "function_value",
              "select": ["$Sq"],
              "x": 3,
              "y": 1
            },
            {"check": "unchanged_except", "since": "after_t1", "except": ["$Sq"]}
          ]
        }
      ]
    },
    {
      "id": "FN-08",
      "title": "Reversed bounds",
      "tags": ["functions", "validation"],
      "smoke": false,
      "targets": "missing validation (update_function validates, draw_function does not)",
      "steps": [
        {
          "user": "Plot y = x from 5 to -5.",
          "reference": [
            {
              "tool": "draw_function",
              "args": {"function_string": "x", "name": "g", "left_bound": 5, "right_bound": -5}
            }
          ],
          "checks": [
            {
              "check": "attribute",
              "path": "args.left_bound",
              "select": {"type": "Function", "only": true},
              "eq": -5
            },
            {
              "check": "attribute",
              "path": "args.right_bound",
              "select": {"type": "Function", "only": true},
              "eq": 5
            }
          ]
        }
      ]
    },
    {
      "id": "FN-09",
      "title": "Removable discontinuity",
      "tags": ["functions", "asymptotes", "discontinuities"],
      "smoke": false,
      "targets": "hole bookkeeping; asymptote detection from the expression text",
      "steps": [
        {
          "user": "Plot (x^2 - 1)/(x - 1) and mark that it has a hole at x = 1.",
          "reference": [
            {
              "tool": "draw_function",
              "args": {"function_string": "(x^2 - 1)/(x - 1)", "name": "h", "undefined_at": [1]}
            }
          ],
          "checks": [
            {
              "check": "attribute",
              "path": "args.point_discontinuities",
              "select": {"type": "Function", "only": true},
              "contains": 1
            },
            {
              "check": "relation",
              "relation": "function_value",
              "select": [{"type": "Function", "only": true}],
              "values": [[2, 3], [0, 1]]
            },
            {
              "check": "attribute",
              "path": "args.vertical_asymptotes",
              "select": {"type": "Function", "only": true},
              "is_null": true
            }
          ]
        }
      ]
    },
    {
      "id": "FN-10",
      "title": "A quotient with abs() draws and its limits answer",
      "tags": ["functions", "asymptotes", "limits"],
      "smoke": false,
      "targets": "a limit never returning for abs(x)/x (K28, the old nerdamer engine): the draw analysis and the limit tool must finish",
      "steps": [
        {
          "user": "Plot the sign function as abs(x)/x from -5 to 5.",
          "reference": [
            {
              "tool": "draw_function",
              "args": {"function_string": "abs(x)/x", "name": "s", "left_bound": -5, "right_bound": 5}
            }
          ],
          "checks": [
            {"check": "no_tool_errors"},
            {
              "check": "relation",
              "relation": "function_value",
              "select": [{"type": "Function", "only": true}],
              "values": [[2, 1], [-3, -1], [4.5, 1]]
            },
            {
              "check": "attribute",
              "path": "args.horizontal_asymptotes",
              "select": {"type": "Function", "only": true},
              "eq": [-1, 1]
            },
            {
              "check": "attribute",
              "path": "args.vertical_asymptotes",
              "select": {"type": "Function", "only": true},
              "is_null": true
            },
            {
              "check": "attribute",
              "path": "args.point_discontinuities",
              "select": {"type": "Function", "only": true},
              "contains": 0
            }
          ]
        },
        {
          "user": "What is the limit of abs(x)/x as x approaches 0, and as x goes to infinity?",
          "reference": [
            {"tool": "limit", "args": {"expression": "abs(x)/x", "variable": "x", "value_to_approach": "0"}},
            {"tool": "limit", "args": {"expression": "abs(x)/x", "variable": "x", "value_to_approach": "inf"}}
          ],
          "checks": [
            {"check": "tool_error", "tool": "limit", "index": 0},
            {"check": "tool_result", "tool": "limit", "index": 0, "contains": "two-sided limit does not exist"},
            {"check": "tool_result", "tool": "limit", "index": 1, "contains": "approaches 1 as x -> Infinity"},
            {"check": "answer_mentions", "numbers": [1, -1]}
          ]
        }
      ]
    },
    {
      "id": "FN-11",
      "title": "Asymptote lists without false or duplicate entries",
      "tags": ["functions", "asymptotes", "discontinuities"],
      "smoke": false,
      "targets": "the tan rule marking every tan(), near-duplicate roots, asymptotes outside the bounds (K32)",
      "steps": [
        {
          "user": "Plot x/tan(x) from -2 to 2.",
          "reference": [
            {
              "tool": "draw_function",
              "args": {"function_string": "x/tan(x)", "name": "c", "left_bound": -2, "right_bound": 2}
            }
          ],
          "checks": [
            {"check": "no_tool_errors"},
            {
              "check": "attribute",
              "path": "args.vertical_asymptotes",
              "select": {"type": "Function", "only": true},
              "is_null": true
            },
            {
              "check": "attribute",
              "path": "args.point_discontinuities",
              "select": {"type": "Function", "only": true},
              "len": 3
            }
          ]
        },
        {
          "user": "Plot 1/(1 - cos(x)) from -1 to 1.",
          "reference": [
            {
              "tool": "draw_function",
              "args": {"function_string": "1/(1 - cos(x))", "name": "r", "left_bound": -1, "right_bound": 1}
            }
          ],
          "checks": [
            {
              "check": "attribute",
              "path": "args.vertical_asymptotes",
              "select": {"type": "Function", "samples": [[0.5, 8.168770850313663]], "tol": 1e-06},
              "eq": [0]
            }
          ]
        },
        {
          "user": "Plot 1/x from 2 to 5.",
          "reference": [
            {
              "tool": "draw_function",
              "args": {"function_string": "1/x", "name": "q", "left_bound": 2, "right_bound": 5}
            }
          ],
          "checks": [
            {
              "check": "attribute",
              "path": "args.vertical_asymptotes",
              "select": {"type": "Function", "samples": [[2, 0.5], [4, 0.25]]},
              "is_null": true
            },
            {
              "check": "relation",
              "relation": "function_value",
              "select": [{"type": "Function", "samples": [[2, 0.5], [4, 0.25]]}],
              "values": [[2, 0.5], [4, 0.25]]
            }
          ]
        }
      ]
    },
    {
      "id": "FN-12",
      "title": "Polar curves: a cardioid and a circle, where they meet",
      "tags": ["functions", "polar", "intersections"],
      "smoke": false,
      "targets": "draw_polar_function, the PolarFunctions bucket and polar intersections reported in theta",
      "steps": [
        {
          "user": "Plot the cardioid r = 1 + cos(θ) and the circle r = 3cos(θ) in red, then find where they meet.",
          "reference": [
            {
              "tool": "draw_polar_function",
              "args": {"r_expression": "1 + cos(θ)", "name": "c", "theta_min": null, "theta_max": null, "color": null}
            },
            {
              "tool": "draw_polar_function",
              "args": {"r_expression": "3*cos(θ)", "name": "k", "theta_min": null, "theta_max": null, "color": "red"}
            },
            {
              "tool": "find_intersections",
              "args": {"object_names": ["c", "k"], "extend_lines": null, "place_points": null}
            }
          ],
          "checks": [
            {"check": "no_tool_errors"},
            {"check": "count", "select": {"type": "PolarFunction"}, "eq": 2},
            {
              "check": "exists",
              "select": {"type": "PolarFunction", "where": {"args.color": "red"}}
            },
            {"check": "tool_result", "tool": "find_intersections", "path": "count", "eq": 3},
            {
              "check": "tool_result",
              "tool": "find_intersections",
              "path": "intersections",
              "has_numbers": [0.75, 1.299038, -1.299038],
              "tol": 1e-6
            },
            {"check": "answer_mentions", "numbers": [0.75]}
          ]
        }
      ]
    },
    {
      "id": "FN-13",
      "title": "Explicit sequence: a term and the trend",
      "tags": ["functions", "sequences"],
      "smoke": false,
      "targets": "plot_sequence draws one SequencePlot and reports its terms and trend",
      "steps": [
        {
          "user": "Plot the sequence u(n) = (n+1)/n for n from 1 to 20. What is the 20th term, and is the sequence increasing or decreasing?",
          "reference": [
            {
              "tool": "plot_sequence",
              "args": {"name": null, "expression": "(n+1)/n", "start": 1, "end": 20, "initial_terms": null, "color": null}
            }
          ],
          "checks": [
            {"check": "no_tool_errors"},
            {"check": "count", "select": {"type": "SequencePlot"}, "eq": 1},
            {"check": "tool_result", "tool": "plot_sequence", "path": "trend", "eq": "decreasing"},
            {"check": "tool_result", "tool": "plot_sequence", "path": "terms", "has_numbers": [2, 1.05], "tol": 1e-9},
            {"check": "answer_mentions", "numbers": [1.05], "words": ["decreasing"]}
          ]
        }
      ]
    },
    {
      "id": "FN-14",
      "title": "Recursive sequence: the 10th Fibonacci number",
      "tags": ["functions", "sequences"],
      "smoke": false,
      "targets": "plot_sequence with u(n-1) and u(n-2) and two initial terms",
      "steps": [
        {
          "user": "Plot the Fibonacci sequence u(n) = u(n-1) + u(n-2) with u(1) = u(2) = 1 for n from 1 to 10. What is the 10th term?",
          "reference": [
            {
              "tool": "plot_sequence",
              "args": {"name": null, "expression": "u(n-1) + u(n-2)", "start": 1, "end": 10, "initial_terms": [1, 1], "color": null}
            }
          ],
          "checks": [
            {"check": "no_tool_errors"},
            {"check": "count", "select": {"type": "SequencePlot"}, "eq": 1},
            {"check": "tool_result", "tool": "plot_sequence", "path": "kind", "eq": "recursive"},
            {"check": "tool_result", "tool": "plot_sequence", "path": "terms", "has_numbers": [34, 55]},
            {"check": "answer_mentions", "numbers": [55]}
          ]
        }
      ]
    },
    {
      "id": "FN-15",
      "title": "Cobweb of cos(x): where the orbit settles",
      "tags": ["functions", "sequences", "cobweb"],
      "smoke": false,
      "targets": "plot_cobweb draws one CobwebPlot and reports a stable fixed point",
      "steps": [
        {
          "user": "Draw a cobweb diagram of g(x) = cos(x) starting at x0 = 1. Where does the orbit settle, and is that point stable?",
          "reference": [
            {
              "tool": "plot_cobweb",
              "args": {"name": null, "function": "cos(x)", "x0": 1, "steps": null, "color": null}
            }
          ],
          "checks": [
            {"check": "no_tool_errors"},
            {"check": "count", "select": {"type": "CobwebPlot"}, "eq": 1},
            {"check": "tool_result", "tool": "plot_cobweb", "path": "behaviour", "eq": "fixed_point"},
            {"check": "tool_result", "tool": "plot_cobweb", "path": "fixed_point", "eq": 0.739085133215, "tol": 1e-6},
            {"check": "tool_result", "tool": "plot_cobweb", "path": "stable", "eq": true},
            {"check": "answer_mentions", "numbers": [0.739]}
          ]
        }
      ]
    },
    {
      "id": "FN-16",
      "title": "Implicit curves and a shaded system of inequalities",
      "tags": ["functions", "implicit", "areas"],
      "smoke": false,
      "targets": "draw_implicit_curve for relations that are not y = f(x), and shade_inequality for a linear programming feasible region (the ImplicitCurves and InequalityColoredAreas buckets)",
      "steps": [
        {
          "user": "Draw the curve x^2 + y^2 = 25 and the hyperbola x*y = 4 in red.",
          "reference": [
            {"tool": "draw_implicit_curve", "args": {"equation": "x^2 + y^2 = 25", "name": null, "color": null}},
            {"tool": "draw_implicit_curve", "args": {"equation": "x*y = 4", "name": null, "color": "red"}}
          ],
          "checks": [
            {"check": "no_tool_errors"},
            {"check": "count", "select": {"type": "ImplicitCurve"}, "eq": 2},
            {"check": "exists", "select": {"type": "ImplicitCurve", "where": {"args.color": "red"}}},
            {"check": "tool_called", "tool": "draw_implicit_curve"}
          ]
        },
        {
          "user": "Now shade the feasible region x + y <= 10, x >= 0, y >= 0.",
          "reference": [
            {
              "tool": "shade_inequality",
              "args": {"inequality": "x + y <= 10, x >= 0, y >= 0", "name": null, "color": null, "opacity": null}
            }
          ],
          "checks": [
            {"check": "no_tool_errors"},
            {"check": "count", "select": {"type": "InequalityColoredArea"}, "eq": 1},
            {"check": "count", "select": {"type": "ImplicitCurve"}, "eq": 2},
            {"check": "tool_result", "tool": "shade_inequality", "path": "in_view.shaded_share", "gt": 0}
          ]
        }
      ]
    }
  ]
}
