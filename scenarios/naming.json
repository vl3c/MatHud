{
  "schema": 1,
  "area": "NM",
  "title": "Naming, editing and deleting",
  "scenarios": [
    {
      "id": "NM-01",
      "title": "Rename and recolour a free point",
      "tags": ["points", "naming", "update"],
      "smoke": false,
      "targets": "edit policy on solitary points",
      "setup": {"calls": [{"tool": "create_point", "args": {"x": 1, "y": 1, "name": "P"}}]},
      "steps": [
        {
          "user": "Rename P to Q and make it red.",
          "reference": [{"tool": "update_point", "args": {"point_name": "P", "new_name": "Q", "new_color": "red"}}],
          "checks": [
            {"check": "count", "select": {"type": "Point"}, "eq": 1},
            {"check": "point_at", "select": {"type": "Point", "name": "Q"}, "at": [1, 1]},
            {"check": "attribute", "path": "inspect.color", "select": {"type": "Point", "name": "Q"}, "eq": "red"}
          ]
        }
      ]
    },
    {
      "id": "NM-02",
      "title": "Renaming a triangle vertex is refused",
      "tags": ["points", "naming", "errors", "undo"],
      "smoke": false,
      "targets": "refusal path; model explanation",
      "setup": {
        "calls": [
          {
            "tool": "create_polygon",
            "args": {
              "vertices": [{"x": 0, "y": 0}, {"x": 4, "y": 0}, {"x": 0, "y": 3}],
              "polygon_type": "triangle",
              "name": "ABC"
            }
          }
        ]
      },
      "steps": [
        {
          "user": "Rename vertex B to P.",
          "reference": [{"tool": "update_point", "args": {"point_name": "B", "new_name": "P"}}],
          "checks": [{"check": "state_equals", "snapshot": "setup"}, {"check": "tool_error", "tool": "update_point"}]
        }
      ]
    },
    {
      "id": "NM-03",
      "title": "Delete a point used by segments, then undo",
      "tags": ["points", "delete", "cascade", "undo"],
      "smoke": true,
      "targets": "cascade delete plus undo consistency",
      "setup": {
        "calls": [
          {
            "tool": "create_polygon",
            "args": {
              "vertices": [{"x": 0, "y": 0}, {"x": 4, "y": 0}, {"x": 0, "y": 3}],
              "polygon_type": "triangle",
              "name": "ABC"
            }
          },
          {"tool": "create_segment", "args": {"x1": 4, "y1": 0, "x2": 6, "y2": 2}}
        ]
      },
      "steps": [
        {
          "user": "Delete point B.",
          "reference": [{"tool": "delete_point", "args": {"x": 4, "y": 0}}],
          "checks": [
            {"check": "absent", "select": {"type": "Point", "at": [4, 0]}},
            {"check": "absent", "select": {"type": "Segment", "ends": [[0, 0], [4, 0]]}},
            {"check": "absent", "select": {"type": "Segment", "ends": [[4, 0], [0, 3]]}},
            {"check": "absent", "select": {"type": "Segment", "ends": [[4, 0], [6, 2]]}},
            {"check": "count", "select": {"type": "Triangle"}, "eq": 0},
            {"check": "exists", "select": {"type": "Point", "at": [0, 0]}},
            {"check": "exists", "select": {"type": "Point", "at": [0, 3]}},
            {"check": "exists", "select": {"type": "Segment", "ends": [[0, 3], [0, 0]]}},
            {"check": "exists", "select": {"type": "Point", "at": [6, 2]}}
          ]
        },
        {"do": [{"tool": "undo", "args": {}}], "checks": [{"check": "state_equals", "snapshot": "setup"}]}
      ]
    },
    {
      "id": "NM-04",
      "title": "Deleting something that does not exist",
      "tags": ["circles", "delete", "results"],
      "smoke": false,
      "targets": "untruthful results for no-op deletes",
      "setup": {"calls": [{"tool": "create_circle", "args": {"center_x": 0, "center_y": 0, "radius": 2}}]},
      "steps": [
        {
          "user": "Delete the circle Z(9).",
          "reference": [{"tool": "delete_circle", "args": {"name": "Z(9)"}}],
          "checks": [{"check": "state_equals", "snapshot": "setup"}, {"check": "tool_error", "tool": "delete_circle"}]
        }
      ]
    },
    {
      "id": "NM-05",
      "title": "Name hint after undo",
      "tags": ["points", "naming", "undo"],
      "smoke": false,
      "targets": "name generator state not rewound",
      "steps": [
        {
          "user": "Create point K at (1,1).",
          "reference": [{"tool": "create_point", "args": {"x": 1, "y": 1, "name": "K"}}]
        },
        {"user": "Undo.", "reference": [{"tool": "undo", "args": {}}]},
        {
          "user": "Create point K at (3,3).",
          "reference": [{"tool": "create_point", "args": {"x": 3, "y": 3, "name": "K"}}],
          "checks": [{"check": "point_at", "select": {"type": "Point", "name": "K"}, "at": [3, 3]}]
        }
      ]
    },
    {
      "id": "NM-06",
      "title": "Deleting one of two triangles that share an edge",
      "tags": ["polygons", "delete", "cascade"],
      "smoke": false,
      "targets": "cascade deletes through shared edges",
      "setup": {
        "calls": [
          {
            "tool": "create_polygon",
            "args": {
              "vertices": [{"x": 0, "y": 0}, {"x": 4, "y": 0}, {"x": 4, "y": 4}],
              "polygon_type": "triangle",
              "name": "ABC"
            }
          },
          {
            "tool": "create_polygon",
            "args": {
              "vertices": [{"x": 0, "y": 0}, {"x": 4, "y": 4}, {"x": 0, "y": 4}],
              "polygon_type": "triangle",
              "name": "ACD"
            }
          }
        ]
      },
      "steps": [
        {
          "user": "Delete triangle ABC.",
          "reference": [
            {
              "tool": "delete_polygon",
              "args": {
                "polygon_type": "triangle",
                "name": "ABC",
                "vertices": [{"x": 0, "y": 0}, {"x": 4, "y": 0}, {"x": 4, "y": 4}]
              }
            }
          ],
          "checks": [
            {"check": "exists", "select": {"type": "Triangle", "vertices": [[0, 0], [4, 4], [0, 4]]}},
            {"check": "exists", "select": {"type": "Segment", "ends": [[0, 0], [4, 4]]}},
            {"check": "exists", "select": {"type": "Segment", "ends": [[4, 4], [0, 4]]}},
            {"check": "exists", "select": {"type": "Segment", "ends": [[0, 4], [0, 0]]}},
            {"check": "absent", "select": {"type": "Segment", "ends": [[0, 0], [4, 0]]}},
            {"check": "absent", "select": {"type": "Segment", "ends": [[4, 0], [4, 4]]}}
          ]
        }
      ]
    },
    {
      "id": "NM-07",
      "title": "Label edits and a move that change nothing say so",
      "tags": ["labels", "update", "no-op", "transforms"],
      "smoke": false,
      "targets": "update_segment label fields, update_label text and translate_object by (0, 0) answering 'Call successful!' with nothing changed (the K26 family)",
      "setup": {
        "calls": [
          {
            "tool": "create_segment",
            "args": {"x1": 0, "y1": 0, "x2": 4, "y2": 0, "name": "AB", "label_text": "base", "label_visible": false}
          },
          {"tool": "create_label", "args": {"x": 1, "y": 3, "text": "note", "name": "L1"}}
        ]
      },
      "steps": [
        {
          "user": "Hide the label of AB.",
          "reference": [{"tool": "update_segment", "args": {"name": "AB", "new_label_visible": false}}],
          "checks": [
            {"check": "tool_result", "tool": "update_segment", "contains": "nothing changed"},
            {"check": "attribute", "path": "args.label.visible", "select": {"type": "Segment", "name": "AB"}, "eq": false}
          ]
        },
        {
          "user": "Set AB's label text to 'base'.",
          "reference": [{"tool": "update_segment", "args": {"name": "AB", "new_label_text": "base"}}],
          "checks": [{"check": "tool_result", "tool": "update_segment", "contains": "nothing changed"}]
        },
        {
          "user": "Change the text of L1 to 'note'.",
          "reference": [{"tool": "update_label", "args": {"name": "L1", "new_text": "note"}}],
          "checks": [{"check": "tool_result", "tool": "update_label", "contains": "nothing changed"}]
        },
        {
          "user": "Move AB by (0, 0).",
          "reference": [{"tool": "translate_object", "args": {"name": "AB", "x_offset": 0, "y_offset": 0}}],
          "checks": [
            {"check": "tool_result", "tool": "translate_object", "contains": "nothing changed"},
            {"check": "state_equals", "snapshot": "setup"}
          ]
        },
        {
          "user": "Show AB's label.",
          "reference": [{"tool": "update_segment", "args": {"name": "AB", "new_label_visible": true}}],
          "checks": [
            {"check": "no_tool_errors"},
            {"check": "attribute", "path": "args.label.visible", "select": {"type": "Segment", "name": "AB"}, "eq": true}
          ]
        }
      ]
    },
    {
      "id": "NM-08",
      "title": "Ellipses keep a requested name and never share one",
      "tags": ["ellipses", "naming", "transforms", "delete"],
      "smoke": false,
      "targets": "create_ellipse honouring a requested name, '_<n>' suffixes for a name in use, name-based tools reaching the right ellipse",
      "steps": [
        {
          "user": "Draw an ellipse named orbit centred at (0, 0) with radii 4 and 2.",
          "reference": [
            {"tool": "create_ellipse", "args": {"center_x": 0, "center_y": 0, "radius_x": 4, "radius_y": 2, "name": "orbit"}}
          ],
          "checks": [
            {"check": "no_tool_errors"},
            {"check": "exists", "select": {"type": "Ellipse", "name": "orbit"}}
          ]
        },
        {
          "user": "Rotate orbit by 45 degrees.",
          "reference": [{"tool": "rotate_object", "args": {"name": "orbit", "angle": 45}}],
          "checks": [
            {"check": "attribute", "path": "args.rotation_angle", "select": {"type": "Ellipse", "name": "orbit"}, "eq": 45, "mod": 180}
          ]
        },
        {
          "user": "Draw another ellipse named orbit centred at (8, 0) with radii 2 and 1.",
          "reference": [
            {"tool": "create_ellipse", "args": {"center_x": 8, "center_y": 0, "radius_x": 2, "radius_y": 1, "name": "orbit"}}
          ],
          "checks": [
            {"check": "count", "select": {"type": "Ellipse"}, "eq": 2},
            {"check": "exists", "select": {"type": "Ellipse", "name": "orbit_1", "center": [8, 0]}},
            {"check": "tool_result", "tool": "create_ellipse", "contains": "orbit_1"}
          ]
        },
        {
          "user": "Delete orbit_1.",
          "reference": [{"tool": "delete_ellipse", "args": {"name": "orbit_1"}}],
          "checks": [
            {"check": "count", "select": {"type": "Ellipse"}, "eq": 1},
            {"check": "exists", "select": {"type": "Ellipse", "name": "orbit", "center": [0, 0]}}
          ]
        }
      ]
    }
  ]
}
