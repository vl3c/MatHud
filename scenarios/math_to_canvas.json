{
  "schema": 1,
  "area": "MC",
  "title": "Math tools feeding the canvas",
  "scenarios": [
    {
      "id": "MC-01",
      "title": "Solve, mark the roots, plot the parabola",
      "tags": ["math", "functions", "points"],
      "smoke": true,
      "targets": "chaining a CAS result into drawing",
      "steps": [
        {
          "user": "Solve x^2 - 5x + 6 = 0, mark the roots on the x-axis and plot the parabola.",
          "reference": [
            {"tool": "solve", "args": {"equation": "x^2 - 5*x + 6", "variable": "x"}},
            {"tool": "create_point", "args": {"x": 2, "y": 0}},
            {"tool": "create_point", "args": {"x": 3, "y": 0}},
            {"tool": "draw_function", "args": {"function_string": "x^2 - 5*x + 6", "name": "p"}}
          ],
          "checks": [
            {"check": "exists", "select": {"type": "Point", "at": [2, 0]}},
            {"check": "exists", "select": {"type": "Point", "at": [3, 0]}},
            {
              "check": "relation",
              "relation": "point_on_function",
              "select": [
                {"type": "Point", "at": [2, 0]},
                {"type": "Point", "at": [3, 0]},
                {"type": "Function", "only": true}
              ]
            },
            {"check": "tool_result", "tool": "solve", "has_numbers": [2, 3]},
            {"check": "max_tool_calls", "max": 6}
          ]
        }
      ]
    },
    {
      "id": "MC-02",
      "title": "System of equations and the intersection",
      "tags": ["math", "functions", "points"],
      "smoke": false,
      "targets": "chaining; function naming",
      "steps": [
        {
          "user": "Solve x + y = 3 and x - y = 1, draw both lines and mark the intersection.",
          "reference": [
            {"tool": "solve_system_of_equations", "args": {"equations": ["x + y = 3", "x - y = 1"]}},
            {"tool": "draw_function", "args": {"function_string": "3 - x", "name": "l1"}},
            {"tool": "draw_function", "args": {"function_string": "x - 1", "name": "l2"}},
            {"tool": "create_point", "args": {"x": 2, "y": 1, "name": "I"}}
          ],
          "checks": [
            {"check": "exists", "select": {"type": "Point", "at": [2, 1]}},
            {
              "check": "relation",
              "relation": "point_on_function",
              "select": [{"type": "Point", "at": [2, 1]}, {"type": "Function", "samples": [[0, 3], [4, -1]]}]
            },
            {
              "check": "relation",
              "relation": "point_on_function",
              "select": [{"type": "Point", "at": [2, 1]}, {"type": "Function", "samples": [[0, -1], [4, 3]]}]
            },
            {"check": "tool_result", "tool": "solve_system_of_equations", "has_numbers": [2, 1]}
          ]
        }
      ]
    },
    {
      "id": "MC-03",
      "title": "Derivative and tangent agree",
      "tags": ["math", "functions", "tangents"],
      "smoke": false,
      "targets": "CAS and numeric derivative consistency",
      "steps": [
        {
          "user": "What is the derivative of x^3 at x = 1? Draw the curve and its tangent there.",
          "reference": [
            {"tool": "derive", "args": {"expression": "x^3", "variable": "x"}},
            {"tool": "draw_function", "args": {"function_string": "x^3", "name": "cub"}},
            {"tool": "draw_tangent_line", "args": {"curve_name": "cub", "parameter": 1}}
          ],
          "checks": [
            {"check": "tool_result", "tool": "derive", "matches": "3\\s*\\*?\\s*x\\s*\\^\\s*2"},
            {"bind": "Tan", "select": {"type": "Segment", "only": true}},
            {
              "check": "relation",
              "relation": "tangent_to",
              "select": ["$Tan", {"type": "Function", "only": true}],
              "x": 1,
              "tol": 1e-06
            },
            {"check": "relation", "relation": "slope", "select": ["$Tan"], "value": 3, "tol": 1e-06},
            {"check": "answer_mentions", "numbers": [3]}
          ]
        }
      ]
    },
    {
      "id": "MC-04",
      "title": "Polar grid and a point given in polar form",
      "tags": ["math", "coordinate-systems", "points"],
      "smoke": false,
      "targets": "polar mode; units",
      "steps": [
        {
          "user": "Switch to the polar grid and put a point at r = 2, theta = 90 degrees.",
          "reference": [
            {"tool": "set_coordinate_system", "args": {"mode": "polar"}},
            {
              "tool": "convert_coordinates",
              "args": {"coord1": 2, "coord2": 1.5707963267948966, "from_system": "polar", "to_system": "cartesian"}
            },
            {"tool": "create_point", "args": {"x": 0, "y": 2}}
          ],
          "checks": [
            {"check": "attribute", "path": "mode", "target": "view", "eq": "polar"},
            {"check": "exists", "select": {"type": "Point", "at": [0, 2]}},
            {"check": "tool_result", "tool": "convert_coordinates", "path": "y", "eq": 2}
          ]
        }
      ]
    },
    {
      "id": "MC-05",
      "title": "Calculator functions and an exact fraction",
      "tags": ["math"],
      "smoke": false,
      "targets": "mod, atan2 and the complex helpers in evaluate_expression; simplify for exact answers (its 7/12 needs the server's SymPy engine, which CI installs: nerdamer alone prints 0.583333333333333333)",
      "steps": [
        {
          "user": "Work out -7 mod 3, atan2(1, -1), the argument of 1 + i and the conjugate of 3 + 4i. Then give 1/3 + 1/4 as an exact fraction.",
          "reference": [
            {"tool": "evaluate_expression", "args": {"expression": "mod(-7, 3)"}},
            {"tool": "evaluate_expression", "args": {"expression": "atan2(1, -1)"}},
            {"tool": "evaluate_expression", "args": {"expression": "arg(1 + i)"}},
            {"tool": "evaluate_expression", "args": {"expression": "conj(3 + 4i)"}},
            {"tool": "simplify", "args": {"expression": "1/3 + 1/4"}}
          ],
          "checks": [
            {"check": "no_tool_errors"},
            {"check": "tool_result", "tool": "evaluate_expression", "any": true, "has_numbers": [2]},
            {"check": "tool_result", "tool": "evaluate_expression", "any": true, "has_numbers": [2.356194490192345]},
            {"check": "tool_result", "tool": "evaluate_expression", "any": true, "has_numbers": [0.7853981633974483]},
            {"check": "tool_result", "tool": "evaluate_expression", "any": true, "matches": "^3 - 4i$"},
            {
              "check": "tool_result",
              "tool": "simplify",
              "eq": "7/12",
              "note": "exact with the server's SymPy engine (CI installs it); nerdamer alone prints 0.583333333333333333"
            },
            {"check": "answer_mentions", "numbers": [2], "matches": "7\\s*/\\s*12"}
          ]
        }
      ]
    },
    {
      "id": "MC-06",
      "title": "Plots of the new functions",
      "tags": ["math", "functions", "asymptotes"],
      "smoke": false,
      "targets": "cbrt, ln|x| and % in function plots; the asymptote of ln|x| found behind its bars",
      "steps": [
        {
          "user": "Plot the cube root of x, ln|x| and x % 2.",
          "reference": [
            {"tool": "draw_function", "args": {"function_string": "cbrt(x)", "name": "f"}},
            {"tool": "draw_function", "args": {"function_string": "ln|x|", "name": "g"}},
            {"tool": "draw_function", "args": {"function_string": "x % 2", "name": "h"}}
          ],
          "checks": [
            {"check": "no_tool_errors"},
            {"check": "count", "select": {"type": "Function"}, "eq": 3},
            {"check": "exists", "select": {"type": "Function", "samples": [[-8, -2], [8, 2]]}},
            {"check": "exists", "select": {"type": "Function", "samples": [[-1, 0], [2.718281828459045, 1]]}},
            {"check": "exists", "select": {"type": "Function", "samples": [[0.5, 0.5], [2.5, 0.5], [-0.5, 1.5]]}},
            {
              "check": "attribute",
              "path": "args.vertical_asymptotes",
              "select": {"type": "Function", "samples": [[-1, 0], [2.718281828459045, 1]]},
              "contains": 0
            }
          ]
        }
      ]
    }
  ]
}
